# ============================================================
#  .gitattributes —— 统一换行符与二进制处理
# ------------------------------------------------------------
#  为什么要这个文件：
#  本项目在 Windows 上开发，仓库里原本同时存在 CRLF 和 LF 两种换行符。
#  如果不声明规则，以后在 macOS / Linux 上改同一个文件时，git 会把
#  整个文件都标记成「已修改」，产生大量无意义的 diff，也无法 review。
# ============================================================

# 仓库内一律存 LF；检出时也保持 LF，保证各平台行为一致
* text=auto eol=lf

# ------------------------------------------------------------
# 二进制文件禁止做换行符转换。
# 图片二进制里会随机出现 0x0D 0x0A 字节序列，一旦被当作换行处理，
# 文件会直接损坏（本项目的 3 个 PNG 就"含有"这种字节）。
# ------------------------------------------------------------
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# 文本类（明确声明，避免被误判为二进制）
*.html text
*.css  text
*.js   text
*.json text
*.xml  text
*.txt  text
*.toml text

# SVG 是文本，走 LF
*.svg text eol=lf

# ------------------------------------------------------------
# 让 GitHub 的语言统计更准确：本项目的 .min.js/.min.css 是第三方库，
# 不计入项目自身代码量
# ------------------------------------------------------------
*.min.js  linguist-vendored
*.min.css linguist-vendored
js/zepto.min.js linguist-vendored
